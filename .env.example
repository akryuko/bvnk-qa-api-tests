# Copy to .env to override any of these. Every value has a working default,
# so the suite runs with no .env file at all.

# The environment under test. Point this at a different deployment to run the
# same suite elsewhere — no test changes required.
BVNK_BASE_URL=https://qa-simulator.shared.bvnk.com

# Per-request socket timeout, seconds.
BVNK_REQUEST_TIMEOUT=15

# Business rules the tests assert against. These are expectations, not inputs:
# change them only if the API's documented behaviour changes.
BVNK_SERVICE_FEE_RATE=0.0001
BVNK_ACCEPTANCE_WINDOW=20

# Settlement is asynchronous; how long to poll for a terminal payment status.
BVNK_SETTLEMENT_TIMEOUT=30
BVNK_SETTLEMENT_POLL_INTERVAL=0.25

# How long to keep polling past a quote's acceptanceExpiryDate before deciding
# it never expired. The API reports PENDING for a second or three after the
# deadline it published, so the transition is polled for, not assumed.
BVNK_EXPIRY_TIMEOUT=15
